# --- Supabase (required for real auth & multi-tenant) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
# SUPABASE_SERVICE_KEY=your-service-role-key (GitHub Actions secret only, never commit)

# --- Email (SMTP for cron reports) ---
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com

# --- Gemini AI ---
GEMINI_API_KEY=your-gemini-key

# --- Modbus / SCADA (optional) ---
MODBUS_HOST=192.168.1.100
MODBUS_PORT=502

# --- SAP (optional, stored per-tenant in DB) ---
# SAP_HOST=
# SAP_CLIENT=
# SAP_USER=
# SAP_PASSWORD=
