# --- AI (optional; offline answers work without these) ---
# Gemini free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
AI_DEFAULT_PROVIDER=gemini
# Or OpenAI:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Email (optional — fill to enable send/inbox) ---
# Gmail: enable 2FA → create an App Password (NOT your normal password).
# Put values here or in Streamlit Cloud Secrets — never commit real credentials.
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USE_TLS=true
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_FOLDER=INBOX
# Aliases also accepted: SMTP_USER, SMTP_PASSWORD, SMTP_HOST, SMTP_PORT, IMAP_HOST

# --- LIVE SCADA (optional overrides for config.yaml) ---
# LIVE_CONNECTION_TYPE=direct   # direct | fastapi | buffer_only
# OCP_U_IP=192.168.1.50
# OCP_U_PORT=502
# FASTAPI_LIVE_URL=http://127.0.0.1:8088/live
# MODBUS_HOST=192.168.1.50
# MODBUS_PORT=502
